#
# Selection order:
# * location =        # exact
# * location ^~       # longest prefix (priority)
# * location ~ or ~*  # first regex match (~* is case-insensitive)
# * location /        # longest prefix (fallback)
#
# Ref https://www.digitalocean.com/community/tutorials/understanding-nginx-server-and-location-block-selection-algorithms#how-nginx-chooses-which-location-to-use-to-handle-requests
server {
  listen 443 ssl;
  listen [::]:443 ssl;

  server_name <%= @host %>;

  ssl_certificate /etc/letsencrypt/live/<%= @certificate %>/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/<%= @certificate %>/privkey.pem;
  <%= @tls_config.join("\n  ") %>

  root  <%= @webroot %>;
  index index.php;

  access_log    off;
  error_log     /var/log/nginx/error.log;
  log_not_found off;
  server_tokens off;

<%- if @allow_only_ips -%>
<%- raise 'allow_only_ips must be non-empty' unless !@allow_only_ips.empty? -%>
  allow 127.0.0.1;
<%- @allow_only_ips.each do |ip| -%>
  allow <%= ip %>;
<%- end -%>
  deny all;
<%- end -%>

  location = /favicon.ico {
    access_log off;
    try_files /wp-content/themes/<%= @active_theme %>/i/favicon.ico /wp-content/themes/jquery/i/favicon.ico;
  }

  location = /robots.txt {
    access_log off;
    try_files $uri /wp-content/themes/<%= @active_theme %>/robots.txt;
  }

  # Avoid noise in PHP error logs from bots accessing includes
  #
  # > Error: Call to undefined function
  # > in /srv/wordpress/sites/jquery_com/wp-admin/includes/file.php
  #
  # https://core.trac.wordpress.org/ticket/9185
  location ^~ /wp-admin/includes/ {
    access_log off;
    deny all;
  }

  include /etc/nginx/wordpress-subsites/<%= @host %>.d/*.conf;

  # Prevent hidden "dotfiles" from being served
  location ~ /\. {
    access_log off;
    deny all;
  }

  # Avoid noise in PHP error logs from bots accessing includes
  #
  # > Error: Call to undefined function
  # > in /srv/wordpress/sites/jquerymobile/wp-includes/customize/class-wp-customize-cropped-image-control.php
  #
  # NOTE: Must not deny /wp-includes/ by prefix because WordPress serves JS/CSS from here.
  location ~ /wp-includes/(.*).php {
    access_log off;
    deny all;
  }

<%- if @gilded_wordpress -%>
  # Avoid matching /resources/ itself as that can be a real page
  # https://jquerymobile.com/resources/
  location ~ ^/resources/(?<name>.+) {
    alias <%= @base_path %>/gw-resources/<%= @host %>/$name;
  }
<%- end -%>

  location ~* \.(css|gif|ico|jpeg|jpg|js|png)$ {
    expires 24h;
  }

  location ~ \.php$ {
    client_max_body_size 25M;
    try_files            $uri =404;
    fastcgi_pass         unix:/run/php/php<%= @php_fpm_version %>-fpm.sock;
    fastcgi_param        SCRIPT_FILENAME $request_filename;
    include              /etc/nginx/fastcgi_params;
    # Set REMOTE_ADDR to the value of the CF-Connecting-IP header
    #
    # For use by the limit-login-attempts plugin, which rate limits by REMOTE_ADDR.
    #
    # We intentionally don't use limit_login_client_type=LIMIT_LOGIN_PROXY_ADDR
    # or X-Forwarded-For. Cloudflare does add the X-Forwarded-For with the real
    # IP on incoming requests, but, it also preserves a fake X-Forwarded-For by
    # end-users, in which case it merely appends the real IP. The plugin should
    # arguably take the last item in a multi-value X-Forwarded-For header, but
    # doesn't. It rejects it (limit_login_get_address > filter_var) and falls
    # back to LIMIT_LOGIN_DIRECT_ADDR (which uses REMOTE_ADDR), and thus
    # attribute the rate limit to a Cloudflare internal IP, which would either
    # be tighter (shared with other users) or broader (load balanced) and that's
    # hard to reason about. Use CF-Connecting-IP instead.
    #
    # https://developers.cloudflare.com/support/troubleshooting/restoring-visitor-ips/restoring-original-visitor-ips/
    #
    # https://github.com/jquery/infrastructure/issues/572
    #
    fastcgi_param        REMOTE_ADDR $http_cf_connecting_ip if_not_empty;
  }

  location / {
    try_files $uri $uri/ /index.php$is_args$args;
  }
}
